{
  "name": "@observe1/cli",
  "version": "1.1.7",
  "type": "module",
  "description": "ObserveOne CLI - AI-powered website monitoring and testing from the command line",
  "main": "dist/index.js",
  "bin": {
    "obs": "./dist/index.js"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "tsx src/index.ts",
    "build": "node scripts/build.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "test": "vitest run && tsx e2e/run-tests.ts",
    "test:unit": "vitest run",
    "test:e2e": "tsx e2e/run-tests.ts",
    "knip": "knip",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "observeone",
    "obs",
    "cli",
    "monitoring",
    "testing",
    "automation",
    "ai",
    "browser-automation"
  ],
  "author": "ObserveOne Team",
  "license": "MIT",
  "dependencies": {
    "axios": "1.13.2",
    "chalk": "5.6.2",
    "commander": "11.1.0",
    "conf": "11.0.2",
    "dotenv": "17.2.3",
    "inquirer": "9.3.8",
    "open": "11.0.0",
    "ora": "8.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "9.0.9",
    "@types/node": "20.19.25",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "eslint": "10.0.3",
    "knip": "5.86.0",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
