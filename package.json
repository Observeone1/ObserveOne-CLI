{
  "name": "observeone-cli",
  "version": "1.1.2",
  "type": "module",
  "description": "ObserveOne CLI - AI-powered website monitoring and testing from the command line",
  "main": "dist/index.js",
  "bin": {
    "obs1": "./dist/index.js"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "tsx src/index.ts",
    "build": "node scripts/build.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "observeone",
    "obs1",
    "cli",
    "monitoring",
    "testing",
    "automation",
    "ai",
    "browser-automation"
  ],
  "author": "ObserveOne Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "conf": "^11.0.2",
    "date-fns": "^2.30.0",
    "dotenv": "^17.2.3",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.14",
    "jsdom": "^27.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
