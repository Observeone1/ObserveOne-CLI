{
  "name": "@observeone/cli",
  "version": "1.37.0",
  "type": "module",
  "description": "ObserveOne CLI - AI-powered website monitoring and testing from the command line",
  "main": "dist/index.js",
  "bin": {
    "obs": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Observeone1/ObserveOne-CLI.git"
  },
  "homepage": "https://www.observeone.com/cli",
  "bugs": {
    "url": "https://github.com/Observeone1/ObserveOne-CLI/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "test": "vitest run && tsx e2e/run-tests.ts",
    "test:unit": "vitest run",
    "test:e2e": "tsx e2e/run-tests.ts",
    "knip": "knip",
    "sonar": "oo-sonar",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "observeone",
    "obs",
    "cli",
    "monitoring",
    "testing",
    "automation",
    "ai",
    "browser-automation"
  ],
  "author": "ObserveOne Team",
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.21.1",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "conf": "^11.0.2",
    "dotenv": "^17.4.2",
    "inquirer": "^9.3.8",
    "open": "^11.0.4",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.16.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "lint-staged": {
    "*.ts": "prettier --write"
  }
}
